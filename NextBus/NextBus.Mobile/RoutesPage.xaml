<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NextBus.Mobile.RoutesPage"
             FlowDirection="RightToLeft">

    <Grid RowDefinitions="Auto, Auto, Auto, *" Padding="15,10,15,15">

        <!-- אזור חיפוש כתובות מוצא ויעד -->
        <VerticalStackLayout Grid.Row="0" Spacing="10">

            <!-- מוצא -->
            <VerticalStackLayout Spacing="4">
                <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                    <Entry x:Name="OriginSearchEntry"
                       Grid.Column="0"
                       Placeholder="נקודת מוצא (למשל: אבן גבירול 3)"
                       TextColor="White"
                       PlaceholderColor="#94A3B8"/>

                            <Button Grid.Column="1"
                        Text="המיקום שלי"
                        Clicked="OnUseCurrentLocationClicked"
                        BackgroundColor="#1E293B"
                        TextColor="#38BDF8"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        Margin="8,0,0,0"
                        Padding="12,0"/>    
                </Grid>

                <Border x:Name="OriginSuggestionsBorder"
                        IsVisible="False"
                        HeightRequest="140"
                        Stroke="#555555"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="#2A2A2A">
                    <CollectionView x:Name="OriginSuggestionsView"
                                    SelectionMode="Single"
                                    SelectionChanged="OnOriginSuggestionSelected">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="12,10">
                                    <Label Text="{Binding DisplayName}" 
                                           FontSize="13" 
                                           TextColor="White" 
                                           LineBreakMode="TailTruncation" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </VerticalStackLayout>

            <!-- יעד -->
            <VerticalStackLayout Spacing="4">
                <Grid ColumnDefinitions="*, Auto">
                    <Entry x:Name="DestinationSearchEntry"
                           Grid.Column="0"
                           Placeholder="לאן נוסעים? (למשל: סבידור)" />
                    <Button x:Name="SearchDestBtn"
                            Grid.Column="1"
                            Text="🔍"
                            Margin="5,0,0,0"
                            Clicked="OnSearchDestClicked" />
                </Grid>

                <Border x:Name="DestinationSuggestionsBorder"
                        IsVisible="False"
                        HeightRequest="140"
                        Stroke="#555555"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="#2A2A2A">
                    <CollectionView x:Name="DestinationSuggestionsView"
                                    SelectionMode="Single"
                                    SelectionChanged="OnDestinationSuggestionSelected">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="12,10">
                                    <Label Text="{Binding DisplayName}" 
                                           FontSize="13" 
                                           TextColor="White" 
                                           LineBreakMode="TailTruncation" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </VerticalStackLayout>

            <Button x:Name="FindRouteButton"
                    Text="מצא מסלול"
                    Clicked="OnFindRouteClicked"
                    BackgroundColor="#1E88E5"
                    TextColor="White"
                    CornerRadius="8"
                    Margin="0,5,0,0" />
        </VerticalStackLayout>

        <!-- אינדיקטור טעינה -->
        <ActivityIndicator x:Name="LoadingIndicator"
                           Grid.Row="2"
                           IsRunning="False"
                           IsVisible="False"
                           Margin="10" />

        <!-- רשימת המסלולים המוצעים -->
        <CollectionView x:Name="RoutesCollectionView" Grid.Row="3" Margin="0,10,0,0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="#334155"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 14"
                BackgroundColor="#111827"
                Margin="0,0,0,16"
                Padding="18,16"
                FlowDirection="RightToLeft">

                        <VerticalStackLayout Spacing="14">

                            <!-- שורה עליונה: תגית הקו מימין, זמן הנסיעה משמאל -->
                            <Grid ColumnDefinitions="*, Auto" FlowDirection="RightToLeft">

                                <!-- צד ימין: מספרי הקווים -->
                                <HorizontalStackLayout Grid.Column="0" 
                                           HorizontalOptions="Start" 
                                           VerticalOptions="Center" 
                                           Spacing="8">

                                    <!-- אם זה קו ישיר -->
                                    <Border BackgroundColor="#0284C7"
                                StrokeShape="RoundRectangle 8"
                                Padding="12,5"
                                IsVisible="{Binding IsDirect}">
                                        <Label Text="{Binding LineNumber, StringFormat='קו {0}'}"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   FontSize="16"/>
                                    </Border>

                                    <!-- אם זה מסלול עם החלפה -->
                                    <HorizontalStackLayout Spacing="6" 
                                               IsVisible="{Binding IsTransfer}" 
                                               VerticalOptions="Center">
                                        <Border BackgroundColor="#2563EB" StrokeShape="RoundRectangle 8" Padding="10,5">
                                            <Label Text="{Binding FirstLineNumber, StringFormat='קו {0}'}" TextColor="White" FontAttributes="Bold" FontSize="14"/>
                                        </Border>
                                        <Label Text="←" TextColor="#94A3B8" VerticalOptions="Center" FontSize="16"/>
                                        <Border BackgroundColor="#7C3AED" StrokeShape="RoundRectangle 8" Padding="10,5">
                                            <Label Text="{Binding SecondLineNumber, StringFormat='קו {0}'}" TextColor="White" FontAttributes="Bold" FontSize="14"/>
                                        </Border>
                                    </HorizontalStackLayout>
                                </HorizontalStackLayout>

                                <!-- צד שמאל: סה"כ זמן מסע -->
                                <Border Grid.Column="1"
                            BackgroundColor="#1E293B"
                            StrokeShape="RoundRectangle 8"
                            Padding="12,5"
                            HorizontalOptions="End"
                            VerticalOptions="Center">
                                    <Label Text="{Binding TotalDurationMinutes, StringFormat='סה״כ {0} דק׳'}"
                               TextColor="#38BDF8"
                               FontAttributes="Bold"
                               FontSize="14"/>
                                </Border>
                            </Grid>

                            <BoxView HeightRequest="1" Color="#1F2937" HorizontalOptions="Fill"/>

                            <!-- ציר זמן המסלול - מיושר כולו לימין -->
                            <VerticalStackLayout Spacing="12" FlowDirection="RightToLeft">

                                <!-- 1. הליכה לתחנה -->
                                <HorizontalStackLayout Spacing="6" HorizontalOptions="Start">
                                    <Label Text="{Binding WalkToStationMinutes, StringFormat='הליכה של {0} דק׳ לתחנה'}" 
                               TextColor="#94A3B8" 
                               FontSize="13"/>
                                    <Label Text="{Binding WalkToStationMeters, StringFormat='({0} מ׳)'}" 
                               TextColor="#64748B" 
                               FontSize="13"/>
                                </HorizontalStackLayout>

                                <!-- 2. עליה לקו ראשון -->
                                <VerticalStackLayout Spacing="2" HorizontalOptions="Start">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="עליה בתחנה:" TextColor="#38BDF8" FontAttributes="Bold" FontSize="14"/>
                                        <Label Text="{Binding OriginStationName}" 
                                   TextColor="#F8FAFC" 
                                   FontAttributes="Bold" 
                                   FontSize="14"/>
                                    </HorizontalStackLayout>

                                    <!-- מספר תחנות נסיעה -->
                                    <Label Text="{Binding FirstLegStops, StringFormat='  נסיעה של {0} תחנות'}"
                               TextColor="#64748B" 
                               FontSize="15"
                               Margin="20,0,0,0"
                               IsVisible="{Binding IsTransfer}"/>
                                    <Label Text="{Binding StopsCount, StringFormat='  נסיעה של {0} תחנות'}"
                               TextColor="#64748B" 
                               FontSize="15"
                               Margin="20,0,0,0"
                               IsVisible="{Binding IsDirect}"/>
                                </VerticalStackLayout>

                                <!-- 3. תחנת החלפה (אם קיימת) -->
                                <Border BackgroundColor="#1E1B4B"
                            Stroke="#4338CA"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            Padding="12,8"
                            HorizontalOptions="Fill"
                            IsVisible="{Binding IsTransfer}">
                                    <VerticalStackLayout Spacing="3">
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="החלפה בתחנה:" TextColor="#A5B4FC" FontAttributes="Bold" FontSize="13"/>
                                            <Label Text="{Binding TransferStationName}" TextColor="#E0E7FF" FontAttributes="Bold" FontSize="13"/>
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding SecondLegStops, StringFormat='  עולים על הקו הבא ל-{0} תחנות'}"
                                   TextColor="#C7D2FE"
                                   FontSize="12"
                                   Margin="20,0,0,0"/>
                                    </VerticalStackLayout>
                                </Border>

                                <!-- 4. ירידה בתחנת היעד -->
                                <HorizontalStackLayout Spacing="6" HorizontalOptions="Start">
                                    <Label Text="ירידה בתחנה:" TextColor="#4ADE80" FontAttributes="Bold" FontSize="14"/>
                                    <Label Text="{Binding DestinationStationName}" 
                               TextColor="#F8FAFC" 
                               FontAttributes="Bold" 
                               FontSize="14"/>
                                </HorizontalStackLayout>

                                <!-- 5. הליכה ליעד סופי -->
                                <HorizontalStackLayout Spacing="6" HorizontalOptions="Start">
                                    <Label Text="{Binding WalkFromStationMinutes, StringFormat='הליכה של {0} דק׳ ליעד'}" 
                               TextColor="#94A3B8" 
                               FontSize="13"/>
                                    <Label Text="{Binding WalkFromStationMeters, StringFormat='({0} מ׳)'}" 
                               TextColor="#64748B" 
                               FontSize="13"/>
                                </HorizontalStackLayout>

                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>