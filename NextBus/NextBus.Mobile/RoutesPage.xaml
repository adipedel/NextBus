<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NextBus.Mobile.RoutesPage"
             Title="חיפוש מסלול"
             FlowDirection="RightToLeft">

    <Grid RowDefinitions="Auto, Auto, *" Padding="15">

        <!-- אזור חיפוש כתובות מוצא ויעד -->
        <VerticalStackLayout Grid.Row="0" Spacing="10">

            <!-- מוצא -->
            <VerticalStackLayout Spacing="2">
                <Entry x:Name="OriginSearchEntry"
                       Placeholder="מאיפה יוצאים? (למשל: דיזנגוף סנטר)"
                       TextChanged="OnOriginTextChanged" />

                <!-- רשימת השלמה למוצא -->
                <CollectionView x:Name="OriginSuggestionsView"
                                MaximumHeightRequest="150"
                                SelectionMode="Single"
                                SelectionChanged="OnOriginSuggestionSelected"
                                IsVisible="False"
                                BackgroundColor="#F8F9FA">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="10,8">
                                <Label Text="{Binding DisplayName}" 
                                       FontSize="12" 
                                       TextColor="#333333" 
                                       LineBreakMode="TailTruncation" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- יעד -->
            <VerticalStackLayout Spacing="2">
                <Entry x:Name="DestinationSearchEntry"
                       Placeholder="לאן נוסעים? (למשל: רכבת סבידור)"
                       TextChanged="OnDestinationTextChanged" />

                <!-- רשימת השלמה ליעד -->
                <CollectionView x:Name="DestinationSuggestionsView"
                                MaximumHeightRequest="150"
                                SelectionMode="Single"
                                SelectionChanged="OnDestinationSuggestionSelected"
                                IsVisible="False"
                                BackgroundColor="#F8F9FA">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="10,8">
                                <Label Text="{Binding DisplayName}" 
                                       FontSize="12" 
                                       TextColor="#333333" 
                                       LineBreakMode="TailTruncation" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- כפתור חיפוש מסלול -->
            <Button Text="מצא מסלול"
                    Clicked="OnFindRouteClicked"
                    BackgroundColor="#1E88E5"
                    TextColor="White"
                    CornerRadius="8"
                    Margin="0,5,0,0" />
        </VerticalStackLayout>

        <ActivityIndicator x:Name="LoadingIndicator"
                           Grid.Row="1"
                           IsRunning="False"
                           IsVisible="False"
                           Margin="10" />

        <!-- רשימת כרטיסי המסלול -->
        <CollectionView x:Name="RoutesCollectionView" Grid.Row="2" Margin="0,10,0,0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="#CCCCCC"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            Padding="14"
                            Margin="0,6">
                        <VerticalStackLayout Spacing="8">

                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Border Grid.Column="0" 
                                        BackgroundColor="#1E88E5" 
                                        StrokeShape="RoundRectangle 6" 
                                        Padding="8,4">
                                    <Label Text="{Binding LineNumber, StringFormat='קו {0}'}" 
                                           TextColor="White" 
                                           FontAttributes="Bold" />
                                </Border>

                                <Label Grid.Column="1" 
                                       Text="{Binding Company}" 
                                       VerticalOptions="Center" 
                                       Margin="8,0" 
                                       TextColor="#666666" />

                                <Label Grid.Column="2" 
                                       Text="{Binding TotalDurationMinutes, StringFormat='סה״כ {0} דק׳'}" 
                                       FontAttributes="Bold" 
                                       TextColor="#0D47A1" 
                                       VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,4" />

                            <VerticalStackLayout Spacing="6">
                                <Label FontSize="13" TextColor="#555555">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="🚶 הליכה לתחנה: " />
                                            <Span Text="{Binding WalkToStationMinutes}" />
                                            <Span Text=" דק׳ (" />
                                            <Span Text="{Binding WalkToStationMeters}" />
                                            <Span Text=" מ׳)" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <Label FontSize="14" TextColor="#222222">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="🚏 עלייה: " FontAttributes="Bold" TextColor="#1E88E5" />
                                            <Span Text="{Binding OriginStationName}" FontAttributes="Bold" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <Label FontSize="13" TextColor="#666666" Margin="15,0,0,0">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="🚌 נסיעה של " />
                                            <Span Text="{Binding StopsCount}" FontAttributes="Bold" TextColor="#1E88E5" />
                                            <Span Text=" תחנות" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <Label FontSize="14" TextColor="#222222">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="🏁 ירידה: " FontAttributes="Bold" TextColor="#2E7D32" />
                                            <Span Text="{Binding DestinationStationName}" FontAttributes="Bold" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <Label FontSize="13" TextColor="#555555">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="🚶 הליכה ליעד: " />
                                            <Span Text="{Binding WalkFromStationMinutes}" />
                                            <Span Text=" דק׳ (" />
                                            <Span Text="{Binding WalkFromStationMeters}" />
                                            <Span Text=" מ׳)" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>