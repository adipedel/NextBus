<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NextBus.Mobile.RoutesPage"
             Title="חיפוש מסלול"
             FlowDirection="RightToLeft">

    <Grid RowDefinitions="Auto, Auto, Auto, *" Padding="15,10,15,15">

        <!-- אזור חיפוש כתובות מוצא ויעד -->
        <VerticalStackLayout Grid.Row="0" Spacing="10">

            <!-- מוצא -->
            <VerticalStackLayout Spacing="4">
                <Grid ColumnDefinitions="*, Auto">
                    <Entry x:Name="OriginSearchEntry"
                           Grid.Column="0"
                           Placeholder="מאיפה יוצאים? (למשל: הבימה)" />
                    <Button x:Name="SearchOriginBtn"
                            Grid.Column="1"
                            Text="🔍"
                            Margin="5,0,0,0"
                            Clicked="OnSearchOriginClicked" />
                </Grid>

                <Border x:Name="OriginSuggestionsBorder"
                        IsVisible="False"
                        HeightRequest="140"
                        Stroke="#555555"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="#2A2A2A">
                    <CollectionView x:Name="OriginSuggestionsView"
                                    SelectionMode="Single"
                                    SelectionChanged="OnOriginSuggestionSelected">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="12,10">
                                    <Label Text="{Binding DisplayName}" 
                                           FontSize="13" 
                                           TextColor="White" 
                                           LineBreakMode="TailTruncation" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </VerticalStackLayout>

            <!-- יעד -->
            <VerticalStackLayout Spacing="4">
                <Grid ColumnDefinitions="*, Auto">
                    <Entry x:Name="DestinationSearchEntry"
                           Grid.Column="0"
                           Placeholder="לאן נוסעים? (למשל: סבידור)" />
                    <Button x:Name="SearchDestBtn"
                            Grid.Column="1"
                            Text="🔍"
                            Margin="5,0,0,0"
                            Clicked="OnSearchDestClicked" />
                </Grid>

                <Border x:Name="DestinationSuggestionsBorder"
                        IsVisible="False"
                        HeightRequest="140"
                        Stroke="#555555"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="#2A2A2A">
                    <CollectionView x:Name="DestinationSuggestionsView"
                                    SelectionMode="Single"
                                    SelectionChanged="OnDestinationSuggestionSelected">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="12,10">
                                    <Label Text="{Binding DisplayName}" 
                                           FontSize="13" 
                                           TextColor="White" 
                                           LineBreakMode="TailTruncation" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </VerticalStackLayout>

            <Button x:Name="FindRouteButton"
                    Text="מצא מסלול"
                    Clicked="OnFindRouteClicked"
                    BackgroundColor="#1E88E5"
                    TextColor="White"
                    CornerRadius="8"
                    Margin="0,5,0,0" />
        </VerticalStackLayout>

        <!-- אינדיקטור טעינה -->
        <ActivityIndicator x:Name="LoadingIndicator"
                           Grid.Row="2"
                           IsRunning="False"
                           IsVisible="False"
                           Margin="10" />

        <!-- רשימת המסלולים המוצעים -->
        <CollectionView x:Name="RoutesCollectionView" Grid.Row="3" Margin="0,10,0,0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="#CCCCCC"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            Padding="14"
                            Margin="0,6">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Border Grid.Column="0" BackgroundColor="#1E88E5" StrokeShape="RoundRectangle 6" Padding="8,4">
                                    <Label Text="{Binding LineNumber, StringFormat='קו {0}'}" TextColor="White" FontAttributes="Bold" />
                                </Border>
                                <Label Grid.Column="1" Text="{Binding Company}" VerticalOptions="Center" Margin="8,0" TextColor="#AAAAAA" />
                                <Label Grid.Column="2" Text="{Binding TotalDurationMinutes, StringFormat='סה״כ {0} דק׳'}" FontAttributes="Bold" TextColor="#64B5F6" VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="#444444" Margin="0,4" />

                            <VerticalStackLayout Spacing="6">
                                <Label FontSize="13" TextColor="#CCCCCC">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="🚶 הליכה לתחנה: " />
                                            <Span Text="{Binding WalkToStationMinutes}" />
                                            <Span Text=" דק׳ (" />
                                            <Span Text="{Binding WalkToStationMeters}" />
                                            <Span Text=" מ׳)" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <Label FontSize="14" TextColor="White">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="🚏 עלייה: " FontAttributes="Bold" TextColor="#1E88E5" />
                                            <Span Text="{Binding OriginStationName}" FontAttributes="Bold" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <Label FontSize="13" TextColor="#AAAAAA" Margin="15,0,0,0">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="🚌 נסיעה של " />
                                            <Span Text="{Binding StopsCount}" FontAttributes="Bold" TextColor="#1E88E5" />
                                            <Span Text=" תחנות" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <Label FontSize="14" TextColor="White">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="🏁 ירידה: " FontAttributes="Bold" TextColor="#81C784" />
                                            <Span Text="{Binding DestinationStationName}" FontAttributes="Bold" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <Label FontSize="13" TextColor="#CCCCCC">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="🚶 הליכה ליעד: " />
                                            <Span Text="{Binding WalkFromStationMinutes}" />
                                            <Span Text=" דק׳ (" />
                                            <Span Text="{Binding WalkFromStationMeters}" />
                                            <Span Text=" מ׳)" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>