<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NextBus.Mobile.Views.StationDetailsPage"
             BackgroundColor="#121212"
             Shell.NavBarIsVisible="False"
             FlowDirection="RightToLeft">

    <Grid RowDefinitions="Auto, Auto, *" Padding="20,10" FlowDirection="RightToLeft">

        <!-- כותרת ראשית של התחנה -->
        <Label x:Name="StationTitleLabel"
               Grid.Row="0"
               Text="פרטי תחנה"
               TextColor="#A78BFA"
               FontSize="26"
               FontAttributes="Bold"
               HorizontalOptions="Start"
               Margin="0,0,0,10"/>

        <!-- שורת סטטוס + מחוון רענון -->
        <HorizontalStackLayout Grid.Row="1" Spacing="8" Margin="0,0,0,15" HorizontalOptions="Start">
            <Label Text="זמני הגעה:"
                   TextColor="White"
                   FontSize="16"
                   FontAttributes="Bold"
                   VerticalOptions="Center"/>

            <ActivityIndicator x:Name="LoadingSpinner"
                               IsRunning="False"
                               IsVisible="False"
                               Color="#38BDF8"
                               WidthRequest="20"
                               HeightRequest="20"
                               VerticalOptions="Center"/>
        </HorizontalStackLayout>

        <!-- רשימת הקווים -->
        <CollectionView x:Name="ArrivalsCollectionView"
                        Grid.Row="2"
                        SelectionMode="None">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="#334155"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="#000000"
                            Padding="16,12"
                            FlowDirection="RightToLeft">

                        <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">

                            <!-- צד ימין: מספר קו + שעת הגעה משוערת -->
                            <VerticalStackLayout Grid.Column="0" HorizontalOptions="Start" Spacing="2">
                                <Label Text="{Binding LineNumber, StringFormat='קו {0}'}"
                                       TextColor="#38BDF8"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Start"/>
                                <Label Text="{Binding ExpectedArrivalTime, StringFormat='הגעה משוערת: {0:HH:mm}'}"
                                       TextColor="#94A3B8"
                                       FontSize="12"
                                       HorizontalOptions="Start"/>
                            </VerticalStackLayout>

                            <!-- מרכז: יעד הקו (מיושר לימין) -->
                            <Label Grid.Column="1"
                                   Text="{Binding DestinationName}"
                                   TextColor="#CBD5E1"
                                   FontSize="14"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Center"
                                   Margin="16,0,16,0"
                                   LineBreakMode="TailTruncation"/>

                            <!-- צד שמאל: תגית זמן הגעה -->
                            <Border Grid.Column="2"
                                    BackgroundColor="#1E293B"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="12,6"
                                    HorizontalOptions="End"
                                    VerticalOptions="Center">
                                <Label Text="{Binding ArrivalText}"
                                       TextColor="#38BDF8"
                                       FontAttributes="Bold"
                                       FontSize="14"/>
                            </Border>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <Label Text="אין נתוני הגעה כרגע לתחנה זו"
                       TextColor="Gray"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Margin="0,40,0,0"/>
            </CollectionView.EmptyView>

        </CollectionView>
    </Grid>
</ContentPage>