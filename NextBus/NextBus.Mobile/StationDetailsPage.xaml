<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NextBus.Mobile.Views.StationDetailsPage"
             BackgroundColor="#121212">

    <Grid RowDefinitions="Auto, Auto, *" Padding="20,10">

        <!-- כותרת ראשית של התחנה -->
        <Label x:Name="StationTitleLabel"
               Grid.Row="0"
               Text="פרטי תחנה"
               TextColor="#A78BFA"
               FontSize="26"
               FontAttributes="Bold"
               HorizontalOptions="End"
               Margin="0,0,0,10"/>

        <!-- שורת סטטוס + מחוון רענון קל -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto, *" Margin="0,0,0,15">
            <ActivityIndicator x:Name="LoadingSpinner"
                               Grid.Column="0"
                               IsRunning="False"
                               IsVisible="False"
                               Color="#38BDF8"
                               WidthRequest="22"
                               HeightRequest="22"/>

            <Label Grid.Column="1"
                   Text="זמני הגעה:"
                   TextColor="White"
                   FontSize="16"
                   FontAttributes="Bold"
                   HorizontalOptions="End"
                   VerticalOptions="Center"/>
        </Grid>

        <!-- רשימת הקווים עם גלילה חלקה -->
        <CollectionView x:Name="ArrivalsCollectionView"
                        Grid.Row="2"
                        SelectionMode="None">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="#334155"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="#000000"
                            Padding="16,12">
                        <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">

                            <!-- שעת הגעה משוערת + מספר קו -->
                            <VerticalStackLayout Grid.Column="2" HorizontalOptions="End" Spacing="2">
                                <Label Text="{Binding LineNumber, StringFormat='קו {0}'}"
                                       TextColor="#38BDF8"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       HorizontalOptions="End"/>
                                <Label Text="{Binding ExpectedArrivalTime, StringFormat='הגעה משוערת: {0:HH:mm}'}"
                                       TextColor="#94A3B8"
                                       FontSize="12"
                                       HorizontalOptions="End"/>
                            </VerticalStackLayout>

                            <!-- יעד הקו -->
                            <Label Grid.Column="1"
                                   Text="{Binding DestinationName}"
                                   TextColor="#CBD5E1"
                                   FontSize="14"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center"
                                   Margin="0,0,20,0"
                                   LineBreakMode="TailTruncation"/>

                            <!-- תגית זמן הגעה -->
                            <Border Grid.Column="0"
                                    BackgroundColor="#1E293B"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="12,6">
                                <Label Text="{Binding ArrivalText}"
                                       TextColor="#38BDF8"
                                       FontAttributes="Bold"
                                       FontSize="14"/>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <Label Text="אין נתוני הגעה כרגע לתחנה זו"
                       TextColor="Gray"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Margin="0,40,0,0"/>
            </CollectionView.EmptyView>

        </CollectionView>
    </Grid>

</ContentPage>