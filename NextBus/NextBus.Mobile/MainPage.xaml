<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NextBus.Mobile.MainPage"
             Title="NextBus - תחנות קרובות"
             FlowDirection="RightToLeft">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- כותרת הראש הראשית -->
            <Label Text="🚌 NextBus"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#1E88E5" />

            <Label Text="תחנות אוטובוס בסביבתך:"
                   FontSize="18"
                   FontAttributes="Bold" />

            <!-- כפתור לרענון/טעינת התחנות -->
            <Button x:Name="LoadStationsBtn"
                    Text="רענן תחנות"
                    Clicked="OnLoadStationsClicked"
                    BackgroundColor="#1E88E5"
                    TextColor="White"
                    CornerRadius="10" />

            <!-- חיווי טעינה בזמן פנייה ל-API -->
            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="False"
                               IsVisible="False"
                               HorizontalOptions="Center" />

            <!-- רשימה להצגת התחנות -->
            <CollectionView x:Name="StationsCollectionView"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,5"
                               Padding="15"
                               BorderColor="#E0E0E0"
                               CornerRadius="10"
                               HasShadow="True">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="{Binding Name}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#333333" />

                                <Label Text="{Binding StationCode, StringFormat='קוד תחנה: {0}'}"
                                       FontSize="14"
                                       TextColor="#666666" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>